<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TaskbarDrawer</AssemblyName>
    <RootNamespace>TaskbarDrawer</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- 版本号：每次发版手动 bump 主版本，构建时间由 MSBuild 自动补上，
         托盘菜单 / 启动提示 / exe 属性里都能直接看到，用来确认跑的是不是最新构建。 -->
    <Version>1.16.1</Version>
    <!-- 用 $(Version) 派生：早先这里是手写的 "1.9.0 · 时间"，升到 1.13 之后界面仍显示 1.9，
         托盘 / 启动提示 / 日志头全跟着错。版本号只能有一个源。
         时间只到「月-日 时:分」：托盘一行放得下，也够区分是不是最新构建。 -->
    <InformationalVersion>$(Version) · $([System.DateTime]::Now.ToString("MM-dd HH:mm"))</InformationalVersion>
    <!-- SDK 默认会再拼一段 40 位 commit sha（1.13.2 · 2026-11-18 13:54+0b0e765…），
         托盘里太长、也没人读；要确认提交直接看 git 就行。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- WFAC010：WinForms 分析器建议把 DPI 感知移到 ApplicationHighDpiMode，
         本程序是 WPF + PerMonitorV2 清单，保持清单设置。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TaskbarDrawer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- WinForms 只为托盘 NotifyIcon 引入；去掉它的隐式 using，避免与 WPF 的
       Point / Rectangle / DragEventArgs 撞名。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 同一张图标也嵌入程序：托盘按 16 / 20 / 24 取帧，不依赖从 exe 反向提取。 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="TaskbarDrawer.Assets.AppIcon.ico" />
    <!-- 说明窗口的矢量示意图：Assets\help-*.svg 是设计源，构建前转成纯 WPF 图形 + 原生文本。 -->
    <EmbeddedResource Include="Assets\help-panel.xaml" LogicalName="TaskbarDrawer.Assets.help-panel.xaml" />
    <EmbeddedResource Include="Assets\help-panel-labels.xaml" LogicalName="TaskbarDrawer.Assets.help-panel-labels.xaml" />
    <EmbeddedResource Include="Assets\help-scene.xaml" LogicalName="TaskbarDrawer.Assets.help-scene.xaml" />
    <EmbeddedResource Include="Assets\help-scene-labels.xaml" LogicalName="TaskbarDrawer.Assets.help-scene-labels.xaml" />
  </ItemGroup>

  <!-- 说明图的 XAML 是运行时资源，不是 WPF Page；避免 SDK 默认把它们当页面编译。 -->
  <ItemGroup>
    <Page Remove="Assets\help-*.xaml" />
  </ItemGroup>

</Project>

